# Copy to .env before the first `docker compose up`. Compose reads .env for
# interpolation; docker-compose.yaml decides which values reach a container.
#
# The quickest correct start, for a dev stack and a deployment alike:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" > .env

# REQUIRED — no default exists anywhere. docker-compose.yaml is also the
# production deployment descriptor, so a default there would be a credential
# published in a public repository. Left empty here for the same reason: an
# example value would be copied to a server sooner or later.
# ⚠️ Interpolated into a URL — keep it URL-safe. @ : / ? # and % corrupt the
# DSN silently instead of failing. Hex output is safe by construction.
# ⚠️ Read by PostgreSQL at initdb only. Setting a new value on an existing
# volume does not change the role's password in the cluster.
POSTGRES_PASSWORD=

# Optional. Defaulted in docker-compose.yaml, shared between the app's DSN and
# the database, and fixed at initdb — changing either after the volume exists
# renames nothing and just breaks the connection.
#POSTGRES_USER=sharespences
#POSTGRES_DB=sharespences

# Optional. Host port for the app; the container always listens on 8080.
#APP_PORT=8080

# Optional. Local http only: Safari refuses to store a Secure cookie over
# plain http and sign-in then fails with nothing visible to explain it.
# A deployment must never set this.
#COOKIE_SECURE=false

# Optional. Screenshot recognizer — off entirely unless VISION_BACKEND is set.
# See README «Screenshot recognizer» for the model and host variables.
#VISION_BACKEND=ollama
